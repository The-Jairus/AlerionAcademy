# Servicio para VPS sin Docker.
#
#   sudo cp despliegue/capacitacion.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now capacitacion
#   sudo systemctl status capacitacion
#
# Ajusta las rutas y el usuario si instalaste en otro sitio.

[Unit]
Description=Plataforma de capacitación
After=network.target

[Service]
Type=simple
User=capacitacion
Group=capacitacion
WorkingDirectory=/opt/capacitacion
Environment="SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria"
Environment="DATA_DIR=/opt/capacitacion/data"
Environment="HTTPS=1"
ExecStart=/opt/capacitacion/.venv/bin/gunicorn \
    --bind 127.0.0.1:8000 \
    --workers 3 --threads 2 \
    --timeout 600 \
    app:app
Restart=always
RestartSec=5

# Endurecimiento básico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/capacitacion/data

[Install]
WantedBy=multi-user.target
